# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_NINJAS_API_KEY: Optional, enables city autocomplete via API Ninjas /v1/city endpoint.
# Generate your key in API Ninjas dashboard and keep quota limits in mind.
VITE_API_NINJAS_API_KEY=""

# Local development and production both call the deployed Laravel API directly.
VITE_API_BACKEND="production"
# API URL: https://cargo.qla.dev/endpoints/api/...

# VITE_GOOGLE_CLIENT_ID: OAuth "Web application" client ID from Google Cloud Console.
# Must match one of the IDs in the backend's GOOGLE_CLIENT_IDS/GOOGLE_WEB_CLIENT_ID
# so /auth/google will accept the ID token. Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=""

# VITE_APPLE_CLIENT_ID: the "Services ID" identifier from a Sign in with Apple config
# in the Apple Developer portal (Certificates, Identifiers & Profiles > Identifiers >
# Services IDs) — NOT the app's Bundle ID used by the native app. That Services ID must
# have this site's domain + this exact origin registered under "Website URLs" (domain
# and return URL), and its identifier must also be added to the backend's
# APPLE_CLIENT_IDS so /auth/apple will accept the token. Leave empty to hide the button.
VITE_APPLE_CLIENT_ID=""
